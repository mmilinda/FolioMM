APP_NAME=MonPortfolio
APP_ENV=production
APP_KEY=base64:TonAppKeyGeneree
APP_DEBUG=false
APP_URL=https://api.ton-domaine.com

# Configuration Base de données de Prod (PostgreSQL / MySQL)
DB_CONNECTION=pgsql
DB_HOST=ton-serveur-db.com
DB_PORT=5432
DB_DATABASE=nom_de_la_bdd
DB_USERNAME=utilisateur_db
DB_PASSWORD=mot_de_passe_securise

# Configuration Cloudinary pour la prod
CLOUDINARY_URL=cloudinary://votre_api_key:votre_secret@votre_cloud_name